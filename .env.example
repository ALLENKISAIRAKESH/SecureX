# SecureX Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/securex

# JSON Web Token Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026

# TOTP 2FA Application Name
TOTP_ISSUER=SecureX

# CORS Allowed Origin (* for development)
CORS_ORIGIN=*
